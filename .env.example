# Copy to .env and fill in. Never commit .env.

# Required: Scanner Agent (gpt-5-mini) and Frontier Agent (gpt-5.1)
OPENAI_API_KEY=sk-...

# Required only for the autonomous planning agent, which uses Claude to write alerts
ANTHROPIC_API_KEY=sk-ant-...

# Telegram reading (MTProto, your own account). Get both at https://my.telegram.org > API development tools.
# Then run once: uv run python scripts/telegram_login.py
TG_API_ID=your-api-id
TG_API_HASH=your-api-hash

# Notifications (each target is used only if its values are set)
PUSHOVER_USER=your-pushover-user-key
PUSHOVER_TOKEN=your-pushover-app-token
# Telegram bot alerts: create a bot with @BotFather, then send it a message and read your chat id
TG_BOT_TOKEN=your-bot-token
TG_CHAT_ID=your-chat-id

# Optional: overrides the Preprocessor's default of ollama/llama3.2 (usd_legacy mode only)
# PRICER_PREPROCESSOR_MODEL=ollama/llama3.2

# Optional: overrides for settings.yaml
# PRICER_MODE=inr              # inr | usd_legacy
# MIN_DISCOUNT_INR=500
# MIN_DISCOUNT_PCT=20
# FRESHNESS_HOURS=6
# TOP_N_PER_RUN=3

# Optional: only needed if populate_vectorstore.py reads a private Hugging Face dataset
# HF_TOKEN=hf_...
