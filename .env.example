# Required: Scanner Agent (gpt-5-mini) and Frontier Agent (gpt-5.1)
OPENAI_API_KEY=sk-...

# Required only for the autonomous planning agent, which uses Claude to write alerts
ANTHROPIC_API_KEY=sk-ant-...

# Required for push notifications when a deal beats the $50 threshold
PUSHOVER_USER=your-pushover-user-key
PUSHOVER_TOKEN=your-pushover-app-token

# Optional: overrides the Preprocessor's default of ollama/llama3.2
# PRICER_PREPROCESSOR_MODEL=ollama/llama3.2

# Optional: only needed if populate_vectorstore.py reads a private Hugging Face dataset
# HF_TOKEN=hf_...
